#include <winver.h>
#include "setup_res.h"

/* VER_MAJOR / VER_MINOR / VER_PATCH come from ..\VERSION (build_setup.bat passes them in).
 * Spark reads the file version to tell whether a newer EchoVRMusic release is out. */
#ifndef VER_MAJOR
#define VER_MAJOR 0
#define VER_MINOR 0
#define VER_PATCH 0
#endif
#define STR_(x) #x
#define STR(x) STR_(x)
#define VER_TEXT STR(VER_MAJOR) "." STR(VER_MINOR) "." STR(VER_PATCH)

IDR_PLUGIN RCDATA "..\\out\\EchoVRMusic.dll"
IDI_APP    ICON   "echovrmusic.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_MAJOR, VER_MINOR, VER_PATCH, 0
 PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "EchoVRMusic: your PC's music through Echo VR's speakers"
            VALUE "FileVersion",      VER_TEXT
            VALUE "ProductName",      "EchoVRMusic"
            VALUE "ProductVersion",   VER_TEXT
            VALUE "OriginalFilename", "EchoVRMusicSetup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
